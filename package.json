{
  "name": "obsidian-atomic",
  "version": "1.0.32",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Obsidian Atomic plugin: habit heatmaps, cues, timers, and dashboards under atomics/",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node --experimental-strip-types --test tests/*.mjs",
    "test:e2e": "npm run build && node --test --test-timeout=180000 e2e/*.test.mjs",
    "docs:user-guide-screenshots": "node scripts/capture-user-guide-screenshots.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.1",
    "obsidian": "^1.5.7-1",
    "selenium-webdriver": "^4.47.0",
    "typescript": "^5.3.3"
  }
}
